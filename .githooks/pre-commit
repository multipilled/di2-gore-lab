#!/bin/sh
# Blocks commits that stage game data, decompiled code or a symlink. Enable once per clone with:
#   git config core.hooksPath .githooks
HOOK_NAME=pre-commit
. "$(dirname "$0")/_python.sh"
find_python
cd "$(git rev-parse --show-toplevel)" || exit 1
# shellcheck disable=SC2086
exec $PY -B tools/check_no_game_files.py --staged
